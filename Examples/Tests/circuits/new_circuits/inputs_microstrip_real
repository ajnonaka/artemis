################################
####### GENERAL PARAMETERS ######
#################################
max_step = 10000000

amr.n_cell = n_cellx n_celly n_cellz
amr.max_grid_size = max_grid_size
amr.blocking_factor = blocking_factor
amr.refine_grid_layout = 1  # if n_MPI > n_grids, the grids will be successively divided in half until n_MPI <= n_grids

geometry.dims = 3
geometry.prob_lo = -Lx/2. 0. 0.
geometry.prob_hi =  Lx/2. Ly Lz

amr.max_level = 0

boundary.field_lo = pml pml pec
boundary.field_hi = pml pml pml

#################################
############ NUMERICS ###########
#################################
warpx.verbose = 1

warpx.cfl = 0.9

# vacuum or macroscopic
algo.em_solver_medium = macroscopic

# laxwendroff or backwardeuler
algo.macroscopic_sigma_method = laxwendroff

###############
# geometry
# each row represents a different part of the circuit
# 1. vacuum everywhere
# 2. si substrate
###############

macroscopic.sigma_function(x,y,z) = "sigma_0
+ (sigma_si - sigma_0) * (z <= h_si)"

macroscopic.epsilon_function(x,y,z) = "eps_0
+ eps_0 * (eps_r_si - 1.) * (z <= h_si)"

macroscopic.mu_function(x,y,z) = "mu_0
+ mu_0 * (mu_r_si - 1.) * (z <= h_si)"

#################################
############ FIELDS #############
#################################

###############
# domain size
# n_cellx/y/z and Lx/y/z are needed to calculate dx/dy/dz
###############
my_constants.n_cellx = 800
my_constants.n_celly = 800
my_constants.n_cellz = 800
my_constants.max_grid_size = 800
my_constants.blocking_factor = 2

my_constants.Lx = 40.e-6
my_constants.Ly = 40.e-6
my_constants.Lz = 40.e-6

###############
# material properties
###############
my_constants.sigma_0 = 0.
my_constants.sigma_si = 0.

my_constants.eps_0 = 8.8541878128e-12
my_constants.eps_r_si = 12.

my_constants.mu_0 = 1.25663706212e-06
my_constants.mu_r_si = 1.0

###############
# silicon and palladium cross section
###############
my_constants.h_si = 20.e-6
my_constants.w_pd = 100.e-9

###############
# waveguide port parameters
###############
my_constants.h_port = 20.e-6
my_constants.w_port = w_pd

my_constants.freq = 10.e9

###############
# derived quantities and fundamental constants - don't touch these
###############

my_constants.pi = 3.14159265358979

# grid spacing
my_constants.dx = Lx / n_cellx
my_constants.dy = Ly / n_celly
my_constants.dz = Lz / n_cellz

my_constants.ddx = dx/1.e6
my_constants.ddy = dy/1.e6
my_constants.ddz = dz/1.e6

###############
# excitation
###############

warpx.E_excitation_on_grid_style = parse_E_excitation_grid_function

warpx.Ex_excitation_flag_function(x,y,z) = "(x > -w_pd/2. - ddx) * (x < w_pd/2. + ddx) * (z > h_si - ddz) * (z < h_si + ddz)"
warpx.Ey_excitation_flag_function(x,y,z) = "(x > -w_pd/2. - ddx) * (x < w_pd/2. + ddx) * (z > h_si - ddz) * (z < h_si + ddz)"
warpx.Ez_excitation_flag_function(x,y,z) = "(x > -w_port/2. - ddx) * (x < w_port/2. + ddx) * (z > 0.1*h_port) * (z < h_port) * (y >= -ddy) * (y <= ddy)"

warpx.Ex_excitation_grid_function(x,y,z,t) = "0."
warpx.Ey_excitation_grid_function(x,y,z,t) = "0."
warpx.Ez_excitation_grid_function(x,y,z,t) = "cos((pi*x)/w_port) * sin(2*pi*freq*t)"

###############
# diagnostics
###############

diagnostics.diags_names = plt chk

###############
# full plotfiles
plt.intervals = 100000
plt.file_min_digits = 8
plt.fields_to_plot = Ex Ey Ez Bx By Bz epsilon
plt.diag_type = Full

chk.file_min_digits = 8
chk.format = checkpoint
chk.intervals = 100000
chk.diag_type = Full

###############
# reduced diags: B-loop to compute current around microstrip
###############
warpx.reduced_diags_names = Iloop_top Iloop_bottom Iloop_left Iloop_right

my_constants.gap = 1.5

Iloop_top.type = RawBFieldReduction
Iloop_top.reduction_type = integral
Iloop_top.integration_type = volume
Iloop_top.intervals = 1
Iloop_top.reduced_function(x,y,z) = "(x > -w_pd/2. - gap*dx) * (x < w_pd/2. + gap*dx) * (y > ddy) * (y < dy - ddy) * (z > h_si + gap*dz - ddz) * (z < h_si + gap*dz + ddz)"

Iloop_bottom.type = RawBFieldReduction
Iloop_bottom.reduction_type = integral
Iloop_bottom.integration_type = volume
Iloop_bottom.intervals = 1
Iloop_bottom.reduced_function(x,y,z) = "(x > -w_pd/2. - gap*dx) * (x < w_pd/2. + gap*dx) * (y > ddy) * (y < dy - ddy) * (z > h_si - gap*dz - ddz) * (z < h_si - gap*dz + ddz)"

Iloop_left.type = RawBFieldReduction
Iloop_left.reduction_type = integral
Iloop_left.integration_type = volume
Iloop_left.intervals = 1
Iloop_left.reduced_function(x,y,z) = "(x > -w_pd/2. - gap*dx - ddx) * (x < -w_pd/2. - gap*dx + ddx) * (y > ddy) * (y < dy - ddy) * (z > h_si - gap*dz) * (z < h_si + gap*dz)"

Iloop_right.type = RawBFieldReduction
Iloop_right.reduction_type = integral
Iloop_right.integration_type = volume
Iloop_right.intervals = 1
Iloop_right.reduced_function(x,y,z) = "(x > w_pd/2. + gap*dx - ddx) * (x < w_pd/2. + gap*dx + ddx) * (y > ddy) * (y < dy - ddy) * (z > h_si - gap*dz) * (z < h_si + gap*dz)"
